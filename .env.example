# Copy to .env.local for local frontend dev.
# Vite proxies /api/v1 (and /uploads) for same-origin cookies — see vite.config.ts.
VITE_API_URL=/api/v1

# --- API proxy target (Render / remote NestJS) ---
# Vercel frontend project: set API_PROXY_TARGET in the Vercel dashboard (never commit the URL).
#   Example value: https://your-service.onrender.com
# Local dev (optional): point Vite proxy at Render instead of localhost:3001
# API_PROXY_TARGET=https://your-service.onrender.com
# SBR_API_PROXY_TARGET=https://your-service.onrender.com
