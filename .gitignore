# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local
.vercel/*

# End-to-end run output: per-journey logs, screenshots and the downloaded PDF. Written on every
# run and uploaded by CI as an artifact, so it is evidence, not source.
artifacts/

# Coverage output, at any depth — the frontend writes ./coverage, backend writes backend/coverage.
# No leading slash, so one line covers both and anything added later.
coverage/

# Secrets. Every env file except the checked-in template, at any depth. This file had no env
# pattern at all until now, so a root `.env` or `.env.production` was committable while `backend/`
# was covered; `.env.local` only looked covered, by the `*.local` line above, which is a Vite
# convention and not an env rule. Match the family, not the members: `vercel env pull` invents
# suffixes, and that is how `.env.vercel.prod` reached the repo (f394bb4).
.env
.env.*
!.env.example

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Local assistant tooling, never committed
.claude/

# Renders of docs/reports/*.html. The HTML is the source and it is committed; the PDF and the PNG
# are printed from it on demand and weigh two megabytes and nine between them. A committed binary
# that regenerates from the file beside it goes stale without anyone noticing, and the stale copy is
# the one that gets emailed.
docs/reports/*.pdf
docs/reports/*.png

# Office lock files. Word writes `~$name.docx` beside a document while it is open and deletes it on
# close; LibreOffice writes `.~lock.name.docx#` for the same reason. They are owner-and-machine
# markers, not content, and committing one tells the repository a file is permanently open by
# somebody who has long since closed it. `docs/inputs/` now takes source documents from the client,
# so these appear whenever one is read, which is how `~$feBuy Realties ID Standard.docx` turned up
# in `git status` while the standard was being read for E9. None are tracked, so these lines are
# enough on their own; nothing needs removing from the index.
~$*.docx
~$*.doc
~$*.xlsx
.~lock.*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
