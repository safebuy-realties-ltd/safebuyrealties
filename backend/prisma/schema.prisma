generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_POSTGRES_URL")
}

enum UserRole {
  BUYER
  SELLER
  PROFESSIONAL
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum ProfessionalType {
  LAWYER
  SURVEYOR
  VALUER
  ARCHITECT
  ENGINEER
  BUILDER
  QUANTITY_SURVEYOR
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ASSIGNED
  IN_VERIFICATION
  VERIFIED
  LIVE
  UNDER_OFFER
  SOLD
  REJECTED
  ARCHIVED
}

enum VerificationStepType {
  SUBMISSION
  DOCUMENT_REVIEW
  FIELD_VERIFICATION
  LEGAL
  SURVEY
  VALUATION
  RISK_REVIEW
  FINAL_APPROVAL
}

enum VerificationStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
  ACCEPTED
  REVISION_REQUESTED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum TransactionStatus {
  INITIATED
  IN_PROGRESS
  COMPLETED
  DD_PURCHASED
  DD_IN_PROGRESS
  DD_COMPLETE
  PURCHASE_PENDING
  PURCHASE_IN_ESCROW
}

enum PaymentIntent {
  DD_SERVICE
  PROPERTY_PURCHASE
}

enum ListingMediaType {
  HERO
  GALLERY
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String
  firstName          String
  lastName           String
  role               UserRole
  isActive           Boolean             @default(true)
  professionalType   ProfessionalType?
  phone              String?
  /// SBR public ID e.g. SBR-BUY-LOS-20260609-001 or SBR-SEL-LOS-20260609-001
  publicId           String?             @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  activationTokens   AccountActivationToken[]
  listings           Listing[]           @relation("SellerListings")
  documentsUploaded Document[]         @relation("DocumentUploader")
  verificationAssigned VerificationStep[] @relation("StepAssignee")
  tasksAssigned      Task[]              @relation("TaskAssignee")
  tasksCreated       Task[]              @relation("TaskCreator")
  payments           Payment[]           @relation("PayerPayments")
  transactions       Transaction[]       @relation("BuyerTransactions")
  professionalProfile ProfessionalProfile?
  powerOfAttorneys   PowerOfAttorney[]   @relation("BuyerPoA")
  notifications      Notification[]
  kycRecord          KycRecord?
  savedProperties    SavedProperty[]     @relation("BuyerSaved")
  inspectionRequests InspectionSlot[]    @relation("InspectionRequester")
  inspectionAssigned InspectionSlot[]    @relation("InspectionProfessional")
  externalProperties ExternalProperty[]  @relation("ExternalPropertyOwner")
  standaloneDdOrders DueDiligenceOrder[] @relation("DdOrderBuyer")
  ddAssignments      DueDiligenceAssignment[] @relation("DdAssignmentProfessional")
}

model Listing {
  id               String             @id @default(uuid())
  sellerId         String
  seller           User               @relation("SellerListings", fields: [sellerId], references: [id])
  /// SBR property ID e.g. SBR-PROP-IKY-2026-00001
  propertyId       String?            @unique
  title            String
  description      String
  location         String
  price            Decimal            @db.Decimal(18, 2)
  currency         String             @default("NGN")
  status           ListingStatus      @default(DRAFT)
  /// True only after staff publishes a verified listing to the public catalogue
  isPublished      Boolean            @default(false)
  propertyType     String?
  beds             Int?
  baths            Int?
  landAreaSqm      Decimal?           @db.Decimal(10, 2)
  buildType        String?
  verifiedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  serviceRequests  ServiceRequest[]
  documents        Document[]
  media            ListingMedia[]
  verificationSteps VerificationStep[]
  tasks            Task[]
  payments         Payment[]
  transactions     Transaction[]
  powerOfAttorneys PowerOfAttorney[]
  savedBy          SavedProperty[]
  inspectionSlots  InspectionSlot[]
  dueDiligenceOrders DueDiligenceOrder[]

  @@index([sellerId, status])
}

model ListingMedia {
  id         String   @id @default(uuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  storageKey String
  type       ListingMediaType
  sortOrder  Int              @default(0)
  createdAt  DateTime @default(now())

  @@index([listingId])
}

model Document {
  id           String   @id @default(uuid())
  listingId    String
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation("DocumentUploader", fields: [uploadedById], references: [id])
  category     String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  createdAt    DateTime @default(now())

  @@index([listingId])
}

model VerificationStep {
  id                     String                   @id @default(uuid())
  listingId              String
  listing                Listing                  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type                   VerificationStepType
  status                 VerificationStepStatus   @default(PENDING)
  assignedProfessionalId String?
  assignedProfessional   User?                    @relation("StepAssignee", fields: [assignedProfessionalId], references: [id])
  notes                  String?
  revisionNote           String?
  completedAt            DateTime?
  order                  Int
  riskFlags              Json                     @default("[]")

  @@index([listingId])
}

model Task {
  id          String     @id @default(uuid())
  listingId   String
  listing     Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  assigneeId  String
  assignee    User       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById String
  createdBy   User       @relation("TaskCreator", fields: [createdById], references: [id])
  title       String
  description String?
  type        String
  status      TaskStatus @default(PENDING)
  dueAt       DateTime?
  documentId  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([assigneeId, status])
}

model Transaction {
  id        String              @id @default(uuid())
  /// Null for standalone (off-platform) due diligence cases
  listingId String?
  listing   Listing?            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User                @relation("BuyerTransactions", fields: [buyerId], references: [id])
  /// SBR due diligence case ID e.g. SBR-CASE-DD-LOS-20260609-001
  caseId    String?             @unique
  /// LISTING (default) or STANDALONE
  source    String              @default("LISTING")
  status    TransactionStatus   @default(INITIATED)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  serviceRequest ServiceRequest?
  dueDiligenceOrder DueDiligenceOrder?
  payments  Payment[]
  powerOfAttorney PowerOfAttorney?
  escrow    Escrow?
  payouts   Payout[]

  @@index([buyerId])
  @@index([listingId])
}

model Payment {
  id                 String        @id @default(uuid())
  listingId          String?
  listing            Listing?      @relation(fields: [listingId], references: [id])
  transactionId      String?
  transaction        Transaction?  @relation(fields: [transactionId], references: [id])
  payerId            String
  payer              User          @relation("PayerPayments", fields: [payerId], references: [id])
  /// SBR transaction ID e.g. SBR-TXN-20260609-001
  transactionPublicId String?      @unique
  amount             Decimal       @db.Decimal(18, 2)
  currency           String        @default("NGN")
  provider           String        @default("paystack")
  providerReference  String?       @unique
  status             PaymentStatus @default(PENDING)
  intent             PaymentIntent @default(DD_SERVICE)
  metadata           Json          @default("{}")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PlatformConfig {
  id                 String   @id @default("singleton")
  vatRate            Decimal  @default(0.075) @db.Decimal(5, 4)
  inspectionFee      Decimal  @default(50000) @db.Decimal(18, 2)
  maxUploadMb        Int      @default(15)
  paystackEnabled    Boolean  @default(true)
  flutterwaveEnabled Boolean  @default(false)
  maintenanceMode    Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

model ProfessionalProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  regulatoryBody     String
  licenseNumber      String
  licenseExpiry      DateTime?
  /// Storage key for uploaded professional license / certificate
  licenseDocumentKey String?
  /// Storage key for government ID used during onboarding
  idDocumentKey      String?
  verifiedStatus     String    @default("PENDING")
  verifiedById       String?
  verifiedAt         DateTime?
  rejectionNote      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model ServiceCatalogItem {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  description String
  basePrice   Decimal      @default(150000) @db.Decimal(18, 2)
  active      Boolean      @default(true)
  sortOrder   Int          @default(0)
  bundles     BundleItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("service_catalog_items")
}

model ServiceBundle {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  description String
  basePrice   Decimal      @db.Decimal(18, 2)
  active      Boolean      @default(true)
  items       BundleItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("service_bundles")
}

model BundleItem {
  bundleId String
  itemId   String
  bundle   ServiceBundle      @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  item     ServiceCatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([bundleId, itemId])
  @@map("bundle_items")
}

model DueDiligenceOrder {
  id                 String            @id @default(uuid())
  transactionId      String?           @unique
  transaction        Transaction?      @relation(fields: [transactionId], references: [id])
  buyerId            String
  buyer              User              @relation("DdOrderBuyer", fields: [buyerId], references: [id])
  /// Platform listing when DD is for an on-platform property
  listingId          String?
  listing            Listing?          @relation(fields: [listingId], references: [id])
  /// Off-platform property subject
  externalPropertyId String?
  externalProperty   ExternalProperty? @relation(fields: [externalPropertyId], references: [id])
  /// SBR service request ID e.g. SBR-SRV-BUY-20260609-001
  serviceId          String?           @unique
  /// SBR case ID e.g. SBR-CASE-DD-LOS-20260609-001
  caseId             String?           @unique
  /// LISTING or STANDALONE
  source             String            @default("LISTING")
  bundleId           String?
  itemIds            Json              @default("[]")
  subtotal           Decimal           @db.Decimal(18, 2)
  vatAmount          Decimal           @db.Decimal(18, 2)
  total              Decimal           @db.Decimal(18, 2)
  /// PENDING | PAID | IN_PROGRESS | COMPLETE | CANCELLED
  status             String            @default("PENDING")
  /// PROCEED | PROCEED_WITH_CAUTION | DO_NOT_PROCEED
  verdict            String?
  reportStorageKeys  Json              @default("[]")
  staffNotes         String?
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  assignments        DueDiligenceAssignment[]

  @@index([buyerId])
  @@index([status])
  @@index([externalPropertyId])
  @@map("due_diligence_orders")
}

/// Staff assigns a verified professional to a standalone DD case (per schedule or full bundle).
model DueDiligenceAssignment {
  id                  String            @id @default(uuid())
  dueDiligenceOrderId String
  dueDiligenceOrder   DueDiligenceOrder @relation(fields: [dueDiligenceOrderId], references: [id], onDelete: Cascade)
  professionalId      String
  professional        User              @relation("DdAssignmentProfessional", fields: [professionalId], references: [id])
  /// Catalog item code e.g. LEGAL_CHECK, or FULL_DD
  scheduleCode        String
  title               String
  /// PENDING | IN_PROGRESS | SUBMITTED
  status              String            @default("PENDING")
  reportStorageKey    String?
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([professionalId, status])
  @@index([dueDiligenceOrderId])
  @@map("due_diligence_assignments")
}

/// Off-platform property submitted for standalone due diligence.
model ExternalProperty {
  id              String              @id @default(uuid())
  createdById     String?
  createdBy       User?               @relation("ExternalPropertyOwner", fields: [createdById], references: [id])
  address         String
  lga             String?
  state           String
  propertyType    String?
  approxSize      String?
  titleRef        String?
  sellerName      String?
  sellerContact   String?
  notes           String?
  /// Client-uploaded supporting docs (storage keys)
  documentKeys    Json                @default("[]")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  serviceRequests ServiceRequest[]
  dueDiligenceOrders DueDiligenceOrder[]

  @@index([createdById])
  @@map("external_properties")
}

model PowerOfAttorney {
  id               String      @id @default(uuid())
  transactionId    String      @unique
  transaction      Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  buyerId          String
  buyer            User        @relation("BuyerPoA", fields: [buyerId], references: [id])
  listingId        String
  listing          Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  pdfStorageKey    String
  documentHash     String      @unique
  qrCodeStorageKey String
  signatureMethod  String
  signatureName    String
  consentFlags     Json
  ipAddress        String?
  userAgent        String?
  executedAt       DateTime    @default(now())

  @@index([documentHash])
  @@index([buyerId])
  @@map("power_of_attorney")
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String
  entityId   String?
  entityType String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

model Escrow {
  id                String      @id @default(uuid())
  transactionId     String      @unique
  transaction       Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  status            String      @default("AWAITING_FUNDS")
  heldAmount        Decimal     @db.Decimal(18, 2)
  releaseConditions Json        @default("[]")
  conditionsMet     Json        @default("[]")
  heldAt            DateTime?
  releasedAt        DateTime?
  refundedAt        DateTime?
  releasedById      String?
  releaseNote       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("escrows")
}

model Payout {
  id               String      @id @default(uuid())
  transactionId    String
  transaction      Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  sellerId         String
  grossAmount      Decimal     @db.Decimal(18, 2)
  platformFee      Decimal     @db.Decimal(18, 2)
  netAmount        Decimal     @db.Decimal(18, 2)
  status           String      @default("PENDING")
  gatewayReference String?
  initiatedAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([transactionId])
  @@index([sellerId])
  @@map("payouts")
}

model KycRecord {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String    @default("NOT_SUBMITTED")
  documentKeys Json      @default("[]")
  reviewerId   String?
  reviewNote   String?
  submittedAt  DateTime?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("kyc_records")
}

model SavedProperty {
  id        String   @id @default(uuid())
  buyerId   String
  buyer     User     @relation("BuyerSaved", fields: [buyerId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([buyerId, listingId])
  @@index([buyerId])
  @@map("saved_properties")
}

model InspectionSlot {
  id             String   @id @default(uuid())
  listingId      String
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  professionalId String?
  professional   User?    @relation("InspectionProfessional", fields: [professionalId], references: [id])
  requestedById  String
  requestedBy    User     @relation("InspectionRequester", fields: [requestedById], references: [id])
  scheduledAt    DateTime
  status         String   @default("REQUESTED")
  outcome        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([listingId])
  @@index([requestedById])
  @@map("inspection_slots")
}

/// Sequential counter for SBR public ID generation (prefix + date bucket).
model IdSequence {
  id        String   @id @default(uuid())
  prefix    String
  dateKey   String
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([prefix, dateKey])
  @@map("id_sequences")
}

/// Guest / standalone service order created before payment (main order reference).
model ServiceRequest {
  id                String            @id @default(uuid())
  /// SBR-SRV-BUY-YYYYMMDD-NNN
  serviceId         String            @unique
  /// Null when order is for an off-platform ExternalProperty
  listingId         String?
  listing           Listing?          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  externalPropertyId String?
  externalProperty  ExternalProperty? @relation(fields: [externalPropertyId], references: [id])
  buyerId           String?
  guestName         String
  guestEmail        String
  guestPhone        String
  bundleId          String?
  itemIds           Json              @default("[]")
  includeInspection Boolean           @default(false)
  inspectionFee     Decimal           @default(0) @db.Decimal(18, 2)
  subtotal          Decimal           @db.Decimal(18, 2)
  vatAmount         Decimal           @db.Decimal(18, 2)
  total             Decimal           @db.Decimal(18, 2)
  /// SBR-CASE-DD-LOC-YYYYMMDD-NNN
  caseId            String            @unique
  transactionId     String?           @unique
  transaction       Transaction?      @relation(fields: [transactionId], references: [id])
  /// LISTING or STANDALONE
  source            String            @default("LISTING")
  status            String            @default("PENDING_PAYMENT")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([listingId])
  @@index([externalPropertyId])
  @@index([guestEmail])
  @@map("service_requests")
}

model AccountActivationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("account_activation_tokens")
}
