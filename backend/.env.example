# Start Postgres first: from this folder run `npm run db:up` (or `docker compose up -d`).
# Credentials match backend/docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/safebuyrealties?schema=public"
JWT_SECRET="change-me-in-production-min-32-chars-long"
PORT=3001
# Comma-separated allowed origins. Production also allows this project's Vercel hostnames
# (safebuyrealties.vercel.app and *-{VERCEL_TEAM_SLUG}.vercel.app previews).
FRONTEND_URL="http://localhost:8080,https://safebuyrealties.vercel.app"
VERCEL_TEAM_SLUG="goodness-ifejesu-olajides-projects"
UPLOAD_DIR="./uploads"
PAYSTACK_SECRET_KEY=""
