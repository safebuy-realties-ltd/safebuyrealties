# Shared cloud Postgres (same DB as Vercel API). Copy to backend/.env — never commit .env.
# Get URL from Prisma Data Platform / team secrets (postgres://...@db.prisma.io:5432/...?sslmode=require)
DATABASE_URL="postgresql://USER:PASS@db.prisma.io:5432/postgres?sslmode=require"
DATABASE_POSTGRES_URL="postgresql://USER:PASS@db.prisma.io:5432/postgres?sslmode=require"
# Required when DATABASE_URL is not localhost (shared cloud Postgres in local dev)
SBR_CONFIRM_CLOUD_DATABASE_URL="true"
# Signs session tokens (7 day expiry). Min 32 chars.
# WARNING: unlike DATABASE_URL, FRONTEND_URL and the Paystack keys, this one has NO boot guard.
# Left unset, the API starts normally and signs every token with the hard-coded fallback
# "dev-secret-change-me" in src/auth/auth.module.ts, which is public in this repository —
# anyone could forge a token for any user. Set it in every deployed environment.
# Tracked as E5-S6 in docs/MVP_OUTSTANDING_BACKLOG.md; see docs/RUNBOOK.md §7.2.
JWT_SECRET="change-me-in-production-min-32-chars-long"
PORT=3001
# Comma-separated allowed origins. Required in production: the API refuses to start without it.
# In production this list plus *-{VERCEL_TEAM_SLUG}.vercel.app (over https, exact host match)
# is the whole allowed set. safebuyrealties*.vercel.app is NOT accepted in production:
# .vercel.app subdomains are first-come-first-served, so anyone can register a project named
# safebuyrealties-<anything>. Outside production that prefix form is still accepted, as are
# localhost and 127.0.0.1 on any port.
# Frontend origins (local dev uses Vite proxy at /api/v1). Production app: safebuyrealties-app.vercel.app
FRONTEND_URL="http://localhost:8080,http://localhost:5173,https://safebuyrealties-app.vercel.app"
# Base URL embedded in Power of Attorney QR codes. Must point at the public /verify
# page. Unset falls back to the first FRONTEND_URL origin + /verify, then to
# https://safebuyrealties.com/verify.
POA_VERIFY_BASE_URL=""
# SMTP. Blocked on a mail domain the client owns (EXT-3 / story E6-S1), so unset everywhere today.
# With SMTP_HOST empty, email is skipped silently: the receipt or alert is written to the
# application log and the method returns without error, so a payment never fails because email
# did — but nobody is notified either. See src/email/email.service.ts and docs/RUNBOOK.md §6.2.
# Auth is only sent when both SMTP_USER and SMTP_PASS are set; port 465 switches on TLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@safebuyrealties.com"
# Optional inbox for standalone DD payment alerts (falls back to SMTP_FROM)
STAFF_ALERT_EMAIL=""
# Vercel team slug, owned by the team and therefore not squattable. In production it is the
# only thing that admits a preview origin (*-{VERCEL_TEAM_SLUG}.vercel.app). Leave it unset in
# production to allow no previews at all — FRONTEND_URL alone applies. Not a startup failure.
VERCEL_TEAM_SLUG="goodness-ifejesu-olajides-projects"
UPLOAD_DIR="./uploads"
# Object storage: local (default) or s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./uploads"
# S3 (when STORAGE_DRIVER=s3)
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_S3_ENDPOINT=""
# Paystack (@alexasomba/paystack-node + paystack-inline). Test keys: https://paystack.com/docs/payments/test-payments/
# REQUIRED in production: with no secret key the API records payments as succeeded and
# payouts as COMPLETED without moving money, so production refuses to start without one.
# See backend/src/config/payments-guard.ts and docs/adr/0003-payment-mock-mode-guard.md.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_TEST_SECRET_KEY=""
PAYSTACK_TEST_PUBLIC_KEY=""
# Force mock checkout callbacks locally even when Paystack keys are present.
# Honoured only when NODE_ENV is development or test. Anywhere else it is ignored and
# logs a warning at startup.
PAYSTACK_FORCE_MOCK="false"
# Optional escrow payout test recipient (defaults: Zenith 057 / 0000000000)
PAYSTACK_PAYOUT_BANK_CODE="057"
PAYSTACK_PAYOUT_ACCOUNT_NUMBER="0000000000"
# `npm run prisma:seed` DELETES EVERY ROW IN 24 TABLES before seeding, against whatever
# DATABASE_URL points at — and DATABASE_URL above is the shared cloud Postgres. SEED_NO_WIPE=1
# skips the wipe. Prefer passing it per command (SEED_NO_WIPE=1 npm run prisma:seed) so you
# have to opt in to destruction rather than remember to opt out. docs/RUNBOOK.md §4.1.
# SEED_NO_WIPE="1"
