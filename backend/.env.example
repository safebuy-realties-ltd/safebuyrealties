# Local: start Postgres with `npm run db:up` (docker compose). Credentials match docker-compose.yml.
# Vercel Storage (Prisma Postgres): connect the store in the Vercel dashboard — it sets
# DATABASE_URL, DATABASE_POSTGRES_URL, and DATABASE_PRISMA_DATABASE_URL automatically.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/safebuyrealties?schema=public"
DATABASE_POSTGRES_URL="postgresql://postgres:postgres@localhost:5432/safebuyrealties?schema=public"
JWT_SECRET="change-me-in-production-min-32-chars-long"
PORT=3001
# Comma-separated allowed origins. Production also allows this project's Vercel hostnames
# (safebuyrealties.vercel.app and *-{VERCEL_TEAM_SLUG}.vercel.app previews).
# Frontend origins (local dev uses Vite proxy at /api/v1). Production app: safebuyrealties-app.vercel.app
FRONTEND_URL="http://localhost:8080,http://localhost:5173,https://safebuyrealties-app.vercel.app"
VERCEL_TEAM_SLUG="goodness-ifejesu-olajides-projects"
UPLOAD_DIR="./uploads"
PAYSTACK_SECRET_KEY=""
