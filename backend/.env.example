# Shared cloud Postgres (same DB as Vercel API). Copy to backend/.env — never commit .env.
# Get URL from Prisma Data Platform / team secrets (postgres://...@db.prisma.io:5432/...?sslmode=require)
DATABASE_URL="postgresql://USER:PASS@db.prisma.io:5432/postgres?sslmode=require"
DATABASE_POSTGRES_URL="postgresql://USER:PASS@db.prisma.io:5432/postgres?sslmode=require"
# Required when DATABASE_URL is not localhost (shared cloud Postgres in local dev)
SBR_CONFIRM_CLOUD_DATABASE_URL="true"
JWT_SECRET="change-me-in-production-min-32-chars-long"
PORT=3001
# Comma-separated allowed origins. Production also allows this project's Vercel hostnames
# (safebuyrealties.vercel.app and *-{VERCEL_TEAM_SLUG}.vercel.app previews).
# Frontend origins (local dev uses Vite proxy at /api/v1). Production app: safebuyrealties-app.vercel.app
FRONTEND_URL="http://localhost:8080,http://localhost:5173,https://safebuyrealties-app.vercel.app"
# Optional inbox for standalone DD payment alerts (falls back to SMTP_FROM)
STAFF_ALERT_EMAIL=""
VERCEL_TEAM_SLUG="goodness-ifejesu-olajides-projects"
UPLOAD_DIR="./uploads"
# Object storage: local (default) or s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./uploads"
# S3 (when STORAGE_DRIVER=s3)
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_S3_ENDPOINT=""
# Paystack (@alexasomba/paystack-node + paystack-inline). Test keys: https://paystack.com/docs/payments/test-payments/
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_TEST_SECRET_KEY=""
PAYSTACK_TEST_PUBLIC_KEY=""
# Force mock checkout callbacks locally even when Paystack keys are present
PAYSTACK_FORCE_MOCK="false"
# Optional escrow payout test recipient (defaults: Zenith 057 / 0000000000)
PAYSTACK_PAYOUT_BANK_CODE="057"
PAYSTACK_PAYOUT_ACCOUNT_NUMBER="0000000000"
