# Primary: Vercel Postgres (no Docker). In backend/: `vercel link` then `vercel env pull .env.local`
# Dashboard → Storage → connect DB → sets DATABASE_URL, DATABASE_POSTGRES_URL automatically.
# Optional local Docker: `npm run db:up` (docker compose) — not required for Vercel-first workflow.
DATABASE_URL="postgresql://USER:PASS@HOST:5432/DATABASE?sslmode=require"
DATABASE_POSTGRES_URL="postgresql://USER:PASS@HOST:5432/DATABASE?sslmode=require"
JWT_SECRET="change-me-in-production-min-32-chars-long"
PORT=3001
# Comma-separated allowed origins. Production also allows this project's Vercel hostnames
# (safebuyrealties.vercel.app and *-{VERCEL_TEAM_SLUG}.vercel.app previews).
# Frontend origins (local dev uses Vite proxy at /api/v1). Production app: safebuyrealties-app.vercel.app
FRONTEND_URL="http://localhost:8080,http://localhost:5173,https://safebuyrealties-app.vercel.app"
VERCEL_TEAM_SLUG="goodness-ifejesu-olajides-projects"
UPLOAD_DIR="./uploads"
# Object storage: local (default) or s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./uploads"
# S3 (when STORAGE_DRIVER=s3)
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_S3_ENDPOINT=""
# Paystack: use PAYSTACK_SECRET_KEY on Vercel; locally PAYSTACK_TEST_SECRET_KEY is also read
PAYSTACK_SECRET_KEY=""
PAYSTACK_TEST_SECRET_KEY=""
PAYSTACK_TEST_PUBLIC_KEY=""
